#lang zuo

;; Orchestrates the WebAssembly (Emscripten) build of Racket CS as a
;; build-system target, reachable as `make wasm` (top-level Makefile ->
;; main.zuo `wasm` -> here) or standalone via
;;   bin/zuo wasm-shell/build.zuo wasm
;;
;; The seven build-wasm.md stages each have a self-contained shell
;; script in this directory; this file is the single entry point that
;; checks prerequisites and runs them in dependency order. The Chez
;; cross-build stages (tpb32l boot, racket.boot, em kernel) drive the
;; native `configure`/zuo cross machinery directly -- the two configure
;; quirks they used to work around (the `MACH` sed and the `mdlinkflags`
;; awk patch) are fixed in `configure` itself; see build-wasm.md's
;; upstream-patches list.
;;
;; Recipe-driven library deps (build-deps.sh: libffi, cairo, pango, ...)
;; remain a manual prerequisite for now -- run build-deps.sh once before
;; `make wasm`. We check for its output and fail with guidance if absent.

(provide-targets targets-at)

;; The deps stage (build-deps.sh) writes this; it is also the file
;; build.sh reads back the final link flags from.
(define deps-linkflags
  (at-source "../racket/src/ChezScheme/em-tpb32l/boot/tpb32l/.wasm-deps-linkflags.txt"))

(define (run-script label name . args)
  (display (~a "\n=== wasm stage: " label " ===\n"))
  (shell/wait (apply build-shell
                     (cons (string->shell (at-source name))
                           (map string->shell args)))
              (hash 'desc (~a "wasm: " label))))

(define (check-deps)
  (unless (file-exists? deps-linkflags)
    (error (~a "missing recipe-driven deps: " deps-linkflags "\n"
               "  -> run wasm-shell/build-deps.sh once first"
               " (it builds libffi/cairo/pango/... and is a\n"
               "     manual prerequisite of `make wasm` for now)"))))

(define (targets-at at-dir [vars (hash)])
  ;; Each stage is its own target so it can be run individually
  ;; (`bin/zuo wasm-shell/build.zuo em-kernel`); `wasm` runs the lot in
  ;; order. The scripts are idempotent and self-source emsdk_env.sh, so
  ;; the ordering here is just the build-wasm.md stage sequence.
  (make-targets
   `([:target wasm ()
              ,(lambda (token . args)
                 (check-deps)
                 (run-script "rktio (cross-compile librktio.a)" "build-rktio.sh")
                 (run-script "tpb32l boot + xpatch" "build-tpb32l-boot.sh")
                 (run-script "racket.boot (cross-build for tpb32l)" "build-racket-boot.sh")
                 (run-script "em kernel (libkernel.a)" "build-em-kernel.sh")
                 (run-script "cross-root collections" "build-racket-collections.sh")
                 (apply run-script (list* "final emcc link" "build.sh" args))
                 (display "\n=== wasm: done ===\n"))
              :command]

     [:target check-deps () ,(lambda (token) (check-deps))]
     [:target rktio () ,(lambda (token) (run-script "rktio" "build-rktio.sh"))]
     [:target tpb32l-boot () ,(lambda (token) (run-script "tpb32l boot + xpatch" "build-tpb32l-boot.sh"))]
     [:target racket-boot () ,(lambda (token) (run-script "racket.boot" "build-racket-boot.sh"))]
     [:target em-kernel () ,(lambda (token) (run-script "em kernel" "build-em-kernel.sh"))]
     [:target collections () ,(lambda (token) (run-script "cross-root collections" "build-racket-collections.sh"))]
     [:target link ()
              ,(lambda (token . args) (apply run-script (list* "final emcc link" "build.sh" args)))
              :command])))
