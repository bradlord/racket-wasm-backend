# The cloned upstream tree and all build artifacts live here (disposable;
# regenerated by `racket build/main.rkt sync apply`).
/.work/

# Collected build outputs.
/dist/

# Per-app build outputs (racket build/main.rkt app <dir> -> <dir>/dist).
/examples/*/dist/
/apps/*/dist/

# Transient build log.
/build.log

# Editor / OS noise.
*.sw?
.DS_Store
/compiled/
**/compiled/

# Browser test harness (test/browser/).
/test/browser/node_modules/
/test/browser/test-results/
/test/browser/playwright-report/
/test/browser/blob-report/
