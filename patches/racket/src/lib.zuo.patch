@@ -245,6 +245,11 @@
   (define who 'configured-targets-at)
   (define configure (hash-ref options 'configure))
   (define configure-args (hash-ref options 'configure-args '()))
+  ;; A non-empty wrapper (e.g. "emconfigure") is prepended to the configure
+  ;; command, so the configure runs as `emconfigure ./configure ...`. This is
+  ;; how the WASM cross build gets `CC=emcc`/`AR=emar` recorded in the
+  ;; generated Makefile, which then drives all downstream `c-compile`/`c-link`.
+  (define configure-wrapper (hash-ref options 'configure-wrapper ""))
   (define inputs (hash-ref options 'inputs '()))
   (unless (list? inputs) (arg-error who "list" inputs))
   (define outputs (hash-ref options 'outputs))
@@ -276,7 +281,11 @@
 					   (cdr cmd)
 					   (hash 'dir dir))]
 			    [else
-                             (shell/wait (map string->shell cmd)
+                             (shell/wait (if (equal? configure-wrapper "")
+                                             (map string->shell cmd)
+                                             (build-shell
+                                              (map string->shell (shell->strings configure-wrapper))
+                                              (map string->shell cmd)))
 					 (hash 'dir dir))]))))
                  (hash 'quiet? #t
                        'co-outputs (cdr outputs))))
@@ -329,12 +338,25 @@
       [else
        (configured-targets-at (hash
                                'configure (build-path rktio-src-dir "configure")
-                               'configure-args (shell->strings (hash-ref config 'RKTIO_CONFIGURE_ARGS ""))
+                               ;; On Emscripten, force rktio's own pthreads OFF while leaving
+                               ;; Chez threaded (tpb32l). The single-threaded WASM runtime never
+                               ;; has concurrent callers, so rktio's locks are unnecessary -- and
+                               ;; every rktio helper-thread (getaddrinfo, background sleep, pending
+                               ;; open, SIGCHLD reaper) is a spawn-then-block that deadlocks under
+                               ;; Emscripten. All of them hang off RKTIO_USE_PTHREADS, so one flag
+                               ;; disables the lot. `--disable-pthread` appended last wins over the
+                               ;; CS-propagated `--enable-pthread`; it affects librktio only (the
+                               ;; host rktio configure is a separate invocation).
+                               'configure-args (let ([args (shell->strings (hash-ref config 'RKTIO_CONFIGURE_ARGS ""))])
+                                                 (if (equal? (hash-ref config 'EMSCRIPTEN "f") "t")
+                                                     (append args (list "--disable-pthread"))
+                                                     args))
                                'inputs (list (build-path rktio-src-dir "Makefile.in")
                                              (build-path rktio-src-dir "rktio_config.h.in"))
                                'outputs (list (build-path rktio-dir "Makefile")
                                               rktio_config.h)
                                'script (build-path rktio-src-dir "build.zuo")
+                               'configure-wrapper (hash-ref config 'CONFIGURE_WRAPPER "")
                                'vars config))]))
