diff --git a/Makefile b/Makefile
index c10c9e2..8997629 100644
--- a/Makefile
+++ b/Makefile
@@ -67,6 +67,56 @@ CONFIGURE_ARGS =
 # replaced with the build subdirectory where `configure` is run
 CONFIGURE_ARGS_qq =
 
+# Command to wrap each `configure` invocation, e.g. `emconfigure` for
+# a WebAssembly/Emscripten cross build. Empty means run `configure`
+# directly.
+CONFIGURE_WRAPPER =
+
+# WebAssembly: additional native C library dependencies to build and
+# link for `make wasm` (libffi is always built). Space-separated recipe
+# names from the recipe-source dir's deps/, or the group alias `draw`
+# (the full cairo/pango stack that racket/draw needs). Empty = libffi only.
+WASM_DEPS =
+
+# WebAssembly: directory holding the native-dep recipe sources
+# (build-deps.sh, deps.sh, symgen.sh, deps/*.sh). Required for
+# `make wasm`; the racket-wasm orchestrator sets it to its repo-side
+# wasm-deps/ dir (absolute path, no spaces -- BUILD_VARS re-expands
+# through the shell).
+WASM_DEPS_SRC_DIR =
+
+# WebAssembly: local (path) packages to `raco pkg install --copy` into
+# share/pkgs for `make wasm`, in addition to the catalog PKGS. Space-separated
+# absolute source dirs. The orchestrator sets this from an app's #:local-pkgs;
+# see build-wasm.md "Local app packages".
+LOCAL_PKGS =
+
+# WebAssembly: app-supplied emcc link JS for `make wasm`, and the surface it
+# targets. LINK_*_JS are space-separated absolute .js paths spliced into the
+# `wasm` link via --pre-js / --post-js / --extern-pre-js; APP_TARGET (node or
+# browser) selects which surface gets them. The orchestrator sets these from an
+# app's #:pre-js/#:post-js/#:extern-pre-js; see build-wasm.md "App-supplied link
+# JS".
+LINK_PRE_JS =
+LINK_POST_JS =
+LINK_EXTERN_PRE_JS =
+APP_TARGET =
+
+# WebAssembly: directory holding the built-in emcc link JS glue
+# (wasmfs-stdin.js, wasmfs-console.js, node-tty.js, node-locate-file.js,
+# node-load-share.js). Required for `make wasm`; the racket-wasm
+# orchestrator sets it to its repo-side runtime-glue/ dir (absolute
+# path, no spaces -- BUILD_VARS re-expands through the shell).
+RUNTIME_GLUE_DIR =
+
+# WebAssembly: extra flags appended verbatim to BOTH the node and browser
+# emcc link commands. Useful for debug builds, e.g.:
+#   make wasm EMCC_EXTRA_FLAGS="-g" SCHEME=... RACKET=...
+# With -g emcc embeds DWARF info in the .wasm; Chrome DevTools and the
+# source-map tooling can decode function names from the crash trace.
+# For full source maps also pass "-gsource-map --source-map-base <url>".
+EMCC_EXTRA_FLAGS =
+
 # ------------------------------------------------------------
 # Cross-build support
 
@@ -185,6 +235,16 @@ BUILD_VARS = MAKE=$(MAKE) \
              CPUS="$(CPUS)" \
              CONFIGURE_ARGS_qq='$(CONFIGURE_ARGS_qq)' \
              CONFIGURE_ARGS="$(CONFIGURE_ARGS)" \
+             CONFIGURE_WRAPPER="$(CONFIGURE_WRAPPER)" \
+             WASM_DEPS="$(WASM_DEPS)" \
+             WASM_DEPS_SRC_DIR="$(WASM_DEPS_SRC_DIR)" \
+             LOCAL_PKGS="$(LOCAL_PKGS)" \
+             LINK_PRE_JS="$(LINK_PRE_JS)" \
+             LINK_POST_JS="$(LINK_POST_JS)" \
+             LINK_EXTERN_PRE_JS="$(LINK_EXTERN_PRE_JS)" \
+             APP_TARGET="$(APP_TARGET)" \
+             RUNTIME_GLUE_DIR="$(RUNTIME_GLUE_DIR)" \
+             EMCC_EXTRA_FLAGS="$(EMCC_EXTRA_FLAGS)" \
              CS_CROSS_SUFFIX="$(CS_CROSS_SUFFIX)" \
              RACKET="$(RACKET)" \
              PLAIN_RACKET="$(PLAIN_RACKET)" \
@@ -223,6 +283,30 @@ cs: $(ZUO)
 bc: $(ZUO)
 	$(RUN_ZUO) in-place $(BUILD_VARS) VM=bc
 
+# WebAssembly (Emscripten) cross build of Racket CS, driven through the
+# stock build system: build the native deps (libffi + any WASM_DEPS),
+# configure + cross-build the tpb32l CS runtime, run the cross `raco
+# setup` (compiling collections to compiled/tpb32l), and emcc-link it
+# (the `wasm-deps` + `wasm-setup` + `wasm` targets in
+# racket/src/cs/c/build.zuo). Requires an active emsdk (source
+# emsdk_env.sh first), a native threaded host Chez (SCHEME=<scheme>), and
+# a host Racket of the same version as the tree (RACKET=<racket>, used as
+# the --cross-server for `raco setup`):
+#   make wasm SCHEME=/path/to/scheme RACKET=/path/to/racket
+# Add the cairo/pango stack for racket/draw with WASM_DEPS="draw":
+#   make wasm WASM_DEPS="draw" SCHEME=... RACKET=...
+# Produces racket/src/build/cs/c/wasm/racket.{js,wasm,data}. See
+# build-wasm.md.
+wasm: $(ZUO)
+	$(RUN_ZUO) wasm $(BUILD_VARS)
+
+# Build ONLY the cross-compiler SDK inputs (no emsdk, no emcc link): configure
+# the tpb32l cross with native cc, build the cross-compiler + run the cross
+# `raco setup` (cross-root tpb32l .zo), stopping before the link. The
+# orchestrator's `cross-sdk` collector harvests the result. See build-wasm.md.
+wasm-cross-sdk: $(ZUO)
+	$(RUN_ZUO) wasm-cross-sdk $(BUILD_VARS)
+
 both: $(ZUO)
 	$(RUN_ZUO) both $(BUILD_VARS)
 
