diff --git a/Makefile b/Makefile
index c10c9e2..bbbe251 100644
--- a/Makefile
+++ b/Makefile
@@ -67,6 +67,34 @@ CONFIGURE_ARGS =
 # replaced with the build subdirectory where `configure` is run
 CONFIGURE_ARGS_qq =
 
+# Command to wrap each `configure` invocation, e.g. `emconfigure` for
+# a WebAssembly/Emscripten cross build. Empty means run `configure`
+# directly.
+CONFIGURE_WRAPPER =
+
+# WebAssembly: additional native C library dependencies to build and
+# link for `make wasm` (libffi is always built). Space-separated recipe
+# names from racket/src/cs/c/wasm-deps/deps/, or the group alias `draw`
+# (the full cairo/pango stack that racket/draw needs). Empty = libffi only.
+WASM_DEPS =
+
+# WebAssembly: local (path) packages to `raco pkg install --copy` into
+# share/pkgs for `make wasm`, in addition to the catalog PKGS. Space-separated
+# absolute source dirs. The orchestrator sets this from an app's #:local-pkgs;
+# see build-wasm.md "Local app packages".
+LOCAL_PKGS =
+
+# WebAssembly: app-supplied emcc link JS for `make wasm`, and the surface it
+# targets. LINK_*_JS are space-separated absolute .js paths spliced into the
+# `wasm` link via --pre-js / --post-js / --extern-pre-js; APP_TARGET (node or
+# browser) selects which surface gets them. The orchestrator sets these from an
+# app's #:pre-js/#:post-js/#:extern-pre-js; see build-wasm.md "App-supplied link
+# JS".
+LINK_PRE_JS =
+LINK_POST_JS =
+LINK_EXTERN_PRE_JS =
+APP_TARGET =
+
 # ------------------------------------------------------------
 # Cross-build support
 
@@ -185,6 +213,13 @@ BUILD_VARS = MAKE=$(MAKE) \
              CPUS="$(CPUS)" \
              CONFIGURE_ARGS_qq='$(CONFIGURE_ARGS_qq)' \
              CONFIGURE_ARGS="$(CONFIGURE_ARGS)" \
+             CONFIGURE_WRAPPER="$(CONFIGURE_WRAPPER)" \
+             WASM_DEPS="$(WASM_DEPS)" \
+             LOCAL_PKGS="$(LOCAL_PKGS)" \
+             LINK_PRE_JS="$(LINK_PRE_JS)" \
+             LINK_POST_JS="$(LINK_POST_JS)" \
+             LINK_EXTERN_PRE_JS="$(LINK_EXTERN_PRE_JS)" \
