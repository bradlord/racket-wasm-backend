+  ;; Install `PKGS` (plus required packages and their deps) into the
+  ;; installation's `share/pkgs` with `--no-setup` (a later `raco setup`
+  ;; compiles them). Shared by `in-place` and the wasm flow, where the
+  ;; cross `wasm-setup` does the compiling for tpb32l. Normally installs
+  ;; sources; on the wasm flow, if a prebuilt binary-only catalog exists
+  ;; (`wasm? = #t`, see `wasm-binary-pkgs`), clean-installs the stripped
+  ;; .zo-only packages from it instead.
+  (define (install-base-pkgs token vars [wasm? #f])
+    (define jobs (get-jobs))
+    (define bin-catalog (at-source "racket/src/.wasm-pkgs-cache/catalog"))
+    (cond
+      ;; WASM build with a prebuilt binary-only catalog present (from
+      ;; `make wasm-binary-pkgs`): clean-install PKGS from it as the sole
+      ;; catalog. The bootstrap source install left the full (source +
+      ;; build-only) tree under share/pkgs with its pkg db; clear that
+      ;; first so build-only packages don't linger and the binary versions
+      ;; install fresh (NOT `--skip-installed`). Each binary package has
+      ;; build-deps stripped from its info.rkt, so `--deps search-auto`
+      ;; walks only runtime deps -- build-deps pruned, image ships .zo-only.
+      ;; See build-wasm.md "Binary-only package preload".
+      [(and wasm? (directory-exists? bin-catalog))
+       (alert "wasm: installing packages from binary-only catalog")
+       (rm* (at-source "racket/share/pkgs"))           ; takes pkgs.rktd db
+       (rm* (at-source "racket/share/links.rktd"))     ; rebuilt by install
+       (rm* (at-source "racket/share/info-cache.rktd")) ; stale cache
+       (raco vars "pkg" "install"
+             (if jobs (list "-j" (~a jobs)) '())
+             "--no-setup" "--pkgs" "--scope" "installation"
+             "--catalog" bin-catalog
+             "--deps" "search-auto"
+             required-pkgs
+             (pkgs-to-install))]
+      [else
+       (pkgs-catalog token vars)
+       (raco vars "pkg" "update"
+             "--all" "--auto" "--no-setup" "--scope" "installation"
+             (shell->strings (lookup 'PKG_UPDATE_OPTIONS)))
+       (raco vars "pkg" "install"
+             (if jobs (list "-j" (~a jobs)) '())
+             "--no-setup" "--pkgs" "--skip-installed" "--scope" "installation"
+             "--deps" "search-auto"
+             required-pkgs
+             (pkgs-to-install))])
