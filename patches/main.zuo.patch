+  ;; Install `PKGS` (plus required packages and their deps) into the
+  ;; installation's `share/pkgs` with `--no-setup` (a later `raco setup`
+  ;; compiles them). Shared by `in-place` and the wasm flow, where the
+  ;; cross `wasm-setup` does the compiling for tpb32l.
+  (define (install-base-pkgs token vars)
+    (define jobs (get-jobs))
+    (pkgs-catalog token vars)
+    (raco vars "pkg" "update"
+          "--all" "--auto" "--no-setup" "--scope" "installation"
+          (shell->strings (lookup 'PKG_UPDATE_OPTIONS)))
+    (raco vars "pkg" "install"
+          (if jobs (list "-j" (~a jobs)) '())
+          "--no-setup" "--pkgs" "--skip-installed" "--scope" "installation"
+          "--deps" "search-auto"
+          required-pkgs
+          (pkgs-to-install))
+    ;; Local app packages (LOCAL_PKGS): absolute source dirs --copy-installed
+    ;; into share/pkgs so the wholesale wasm preload ships them (a --link from
+    ;; an outside path would record an absolute host path absent in MEMFS). The
+    ;; named PKGS above install first; these resolve deps via --deps search-auto.
+    ;; `install` errors on an already-present package and `update` on an absent
+    ;; one, so pick per package by checking share/pkgs/<name>; `update --copy`
+    ;; re-copies an edited local package.
+    (for-each
+     (lambda (p)
+       (define name (~a (cdr (split-path p))))
+       (define installed? (directory-exists? (at-source (~a "racket/share/pkgs/" name))))
+       (raco vars "pkg" (if installed? "update" "install")
+             (if jobs (list "-j" (~a jobs)) '())
+             "--copy" "--no-setup" "--scope" "installation"
+             "--deps" "search-auto"
+             p))
+     (shell->strings (lookup 'LOCAL_PKGS))))
