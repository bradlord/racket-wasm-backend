+  ;; ------------------------------------------------------------
+  ;; WebAssembly (Emscripten) build -- configure + cross-build the CS
+  ;; runtime for tpb32l and emcc-link it, all through the stock build
+  ;; system (the `wasm` target in racket/src/cs/c/build.zuo). See
+  ;; build-wasm.md. Pass SCHEME=<native-threaded-host-scheme> and
+  ;; RACKET=<host-racket>, and make sure the emsdk is sourced. The native
+  ;; library deps (libffi + any WASM_DEPS) are built automatically by the
+  ;; `wasm-deps` target in racket/src/cs/c/build.zuo.
+
+  (define (wasm token)
+    (build-base "cs/c" token (hash 'wasm? #t)))
+
+  ;; Cross-compiler SDK: configure + build the tpb32l cross-compiler and run the
+  ;; cross `raco setup` (cross-root tpb32l .zo), stopping before the emcc link --
+  ;; no emsdk, no wasm-deps. The orchestrator's SDK collector then harvests the
+  ;; retarget files + cross-root. See build-wasm.md "Cross-compiler SDK".
+  (define (wasm-cross-sdk token)
+    (build-base "cs/c" token (hash 'sdk? #t)))
+
+  ;; The cross-INSTALL step: the same cross flow as `wasm-cross-sdk`, but this is
+  ;; the ONLY wasm target the orchestrator passes app `PKGS`/`LOCAL_PKGS` to. It
+  ;; `install-base-pkgs` + `wasm-setup`-compiles those packages to tpb32l onto the
+  ;; (otherwise package-blank) cross-root. Keeping it a distinct target lets
+  ;; `wasm` and `wasm-cross-sdk` stay package-agnostic (always `PKGS=`); the app's
+  ;; packages are layered on here. See build-wasm.md "Package-blank runtime/SDK".
+  (define (wasm-install-pkgs token)
+    (build-base "cs/c" token (hash 'sdk? #t)))
+
+  ;; Standalone step (run manually after a bootstrap `make wasm`): strip the
+  ;; already-cross-compiled in-tree packages into a cached binary-only
+  ;; catalog under racket/src/.wasm-pkgs-cache, which the next `make wasm`
+  ;; consumes (see `install-base-pkgs`). Not a dependency of `wasm`. See
+  ;; build-wasm.md "Binary-only package preload".
+  ;;
+  ;; The script must run in the **cross-compiler** context, because
+  ;; `pkg/strip`'s `fixup-zo` reads each tpb32l ".zo" (compiled fasl is
+  ;; machine-specific, unreadable by a plain host racket). Supply the same
+  ;; cross flags `raco setup` uses: `--cross-compiler tpb32l <cs/c-build>`
+  ;; plus `-MCR <cs/c-build>/compiled:` and `-G <build/config>`. Use a bare
+  ;; vars hash (just the exe) so `find-racket`'s `-X racket/collects` /
+  ;; `-G racket/etc` don't shadow the host racket's own collects, which is
+  ;; where pkg/strip et al. resolve from.
+  (define (wasm-binary-pkgs token)
+    (define exe (hash-ref (find-racket vm) 'racket))
+    (define cross-build (at-source "racket/src/build/cs/c"))
+    ;; compiled-file-roots, searched in order:
+    ;;   1. <cross-build>/compiled -- the cross compiler's own modules
+    ;;      (cross-serve etc.), needed by `--cross-compiler`.
+    ;;   2. build/zo -- the machine-INDEPENDENT cross output (`-MCR`,
+    ;;      get-mcr-args). `generate-stripped-directory` loads each
+    ;;      package's `info.rkt` via `get-info/full`, which EXECUTES it on
+    ;;      the host; the per-package `compiled/info_rkt.zo` under
+    ;;      `share/pkgs` is tpb32l (target) and unloadable on the host
+    ;;      (`fasl-read: incompatible ... 'tpb32l`). build/zo holds the
+    ;;      host-loadable machine-independent copy, so it MUST precede the
+    ;;      trailing "" ('same = `share/pkgs/.../compiled`, tpb32l) below.
+    ;;      (`fixup-zo` reads the tpb32l package `.zo` by direct path, not
+    ;;      via module resolution, so the shipped bytecode stays tpb32l.)
+    (racket (hash 'racket exe)
+            "-G" (path-only build-config.rktd)
+            "-MCR" (~a (path->complete-path (build-path cross-build "compiled")) ":"
+                       (path->complete-path (at-source "build/zo")) ":")
+            "--cross-compiler" "tpb32l" cross-build
+            (at-source "racket/src/build-wasm-binary-pkgs.rkt")))
+
