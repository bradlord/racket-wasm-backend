/* wasm_extras.inc -- foreign-symbol registrations injected into
   boot.c's init_foreign for the WASM/Emscripten build (gated by
   -DRACKET_EXTRA_FOREIGN_INC=\"wasm_extras.inc\"). Each line
   registers one C symbol so it's reachable from Racket via
   foreign-procedure / get-ffi-obj, the same way rktio.inc registers
   the rktio surface. Add new wasm-specific primitives here, declaring
   each with its real prototype so the C type is correct.

   wasm_deps.inc is auto-generated by wasm-shell/symgen.sh from the
   symbol manifests of recipes under wasm-shell/deps/. It is placed in
   the same -I path as this file and uses empty-parens externs so the
   address can be taken without a real prototype. Generated lines do
   not collide with anything in boot.c's includes; if you add a recipe
   for a library whose headers boot.c does include, register those
   symbols by hand below instead. */

#include "wasm_deps.inc"

{
  extern int wasm_http_get(const char *, void *, int);
  Sforeign_symbol("wasm_http_get",  (void *)wasm_http_get);
}

{
  extern int wasm_canvas_blit(int, int, const void *);
  Sforeign_symbol("wasm_canvas_blit", (void *)wasm_canvas_blit);
}

{
  extern int wasm_canvas_blit_bgra(int, int, const void *);
  Sforeign_symbol("wasm_canvas_blit_bgra", (void *)wasm_canvas_blit_bgra);
}


